# ============================================================
# SysproERP Reports — PRODUÇÃO (servidor do cliente)
# Copie para .env na pasta de instalação e ajuste os valores.
# ============================================================

# URL/porta que os USUÁRIOS usarão no navegador (ajuste!)
# Acesso interno (mesma rede) ou externo (Radmin/Tailscale/etc.)
BETTER_AUTH_URL="https://vendas.exemplo.local"
BETTER_AUTH_SECRET="GERAR-COM-openssl-rand-base64-32"
BETTER_AUTH_TRUSTED_ORIGINS="https://vendas.exemplo.local"
DATABASE_URL="file:./dev.db"

# A conexão (URL e modo IIS) é configurada por empresa na tela Configurações.
# Liste aqui todas as origens Syspro que o backend pode acessar.
SYSPRO_ALLOWED_ORIGINS="http://localhost:1234"

# Primeiro bootstrap somente: informe valores fortes antes de instalar.
SEED_ADMIN_EMAIL="admin@empresa.com"
SEED_ADMIN_PASSWORD="TROQUE-POR-UMA-SENHA-FORTE"
SEED_ADMIN_NAME="Administrador"

# Porta do servidor Next (padrão 3000)
PORT=3000
# Use 127.0.0.1 atrás de proxy HTTPS; use 0.0.0.0 somente para acesso direto na rede.
HOST=127.0.0.1

# Somente desenvolvimento: hosts/IPs adicionais que podem acessar o next dev.
# ALLOWED_DEV_ORIGINS="192.168.1.10,meu-host-vpn"
